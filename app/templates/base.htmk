<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ settings.site_title if settings else 'Departamento' }}</title>
  <link rel="stylesheet" href="{{ url_for('static', filename='css/styles.css') }}">
</head>
<body>
  <header class="site-header">
    <div class="container nav-wrap">
      <a class="brand" href="{{ url_for('home') }}">{{ settings.site_title if settings else 'Departamento' }}</a>
      <button id="menuBtn" class="menu-btn" aria-label="Abrir menú">☰</button>
      <nav id="mainNav" class="main-nav">
        <a href="#recursos">Recursos</a>
        <a href="#informacion">Información</a>
        <a href="#nosotros">Nosotros</a>
        <a href="#libro-anio">Libro del Año</a>
        {% if session.get('admin_id') %}
          <a href="{{ url_for('admin_dashboard') }}">Admin</a>
          <a href="{{ url_for('admin_logout') }}">Salir</a>
        {% else %}
          <a href="{{ url_for('admin_login') }}">Administrador</a>
        {% endif %}
      </nav>
    </div>
  </header>

  {% with messages = get_flashed_messages(with_categories=true) %}
  {% if messages %}
  <div class="container flash-wrap">
    {% for category, message in messages %}
      <div class="flash {{ category }}">{{ message }}</div>
    {% endfor %}
  </div>
  {% endif %}
  {% endwith %}

  <main>
    {% block content %}{% endblock %}
  </main>

  <footer class="site-footer">
    <div class="container">
      <p>© {{ settings.site_subtitle if settings else 'Misión Villaperla' }} | Plataforma oficial</p>
    </div>
  </footer>

  <script src="{{ url_for('static', filename='js/app.js') }}"></script>
</body>
</html>
